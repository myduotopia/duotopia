# Duotopia Production Environment Configuration
# ==========================================
# ⚠️ CRITICAL: Ensure all secrets are properly secured!

# ===== DATABASE CONFIGURATION =====
DATABASE_TYPE=cloud
# Use Cloud SQL for production with SSL
DATABASE_URL=postgresql://[user]:[password]@[cloud-sql-ip]/duotopia-production?sslmode=require

# ===== AUDIO ERROR MONITORING =====
# 錄音錯誤監控永遠連接到生產環境 Supabase（BigQuery 錯誤日誌是全局的）
# 在 Production 環境，此 URL 與實際的生產環境 DATABASE_URL 相同
PROD_DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROD_PROJECT:YOUR_PROD_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ===== JWT CONFIGURATION =====
JWT_SECRET=[strong-random-secret-for-production-NEVER-SHARE]
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== ENVIRONMENT =====
ENVIRONMENT=production

# ===== PAYMENT CONFIGURATION =====
# 🚫 Production: 付款功能控制（免費優惠期間設為 false）
ENABLE_PAYMENT=false

# ===== GCP PROJECT =====
GCP_PROJECT_ID=duotopia-472708
REGION=asia-east1
GCS_BUCKET_NAME=duotopia-audio-production
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json

# ===== OPENAI API =====
OPENAI_API_KEY=[production-api-key]

# ===== AZURE SPEECH SERVICE =====
AZURE_SPEECH_KEY=[production-azure-key]
AZURE_SPEECH_REGION=japaneast

# ===== DEMO MODE CONFIGURATION =====
# Allowed origins for demo speech token requests (comma-separated)
DEMO_ALLOWED_ORIGINS=https://duotopia.co,https://www.duotopia.net

# ===== EMAIL CONFIGURATION =====
# Consider using SendGrid or AWS SES for production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=myduotopia@gmail.com
SMTP_PASSWORD=[app-password]
FROM_EMAIL=noreply@duotopia.com
FROM_NAME=Duotopia
FRONTEND_URL=https://www.duotopia.com

# ===== TAPPAY CONFIGURATION (Production) =====
TAPPAY_APP_ID=[production-app-id]
TAPPAY_APP_KEY=[production-app-key]
TAPPAY_PARTNER_KEY=[production-partner-key]
TAPPAY_MERCHANT_ID=[production-merchant-id]
# 🔴 Production 必須用 production 環境
TAPPAY_ENV=production
# 🔴 Production 絕對不能用 Mock！
USE_MOCK_PAYMENT=false

# ===== ADDITIONAL PRODUCTION SETTINGS =====
# Webhook URL for TapPay callbacks
TAPPAY_WEBHOOK_URL=https://api.duotopia.com/api/payment/webhook

# Enable 3D Secure for additional security
TAPPAY_USE_3DS=true

# Backend URL for internal use
BACKEND_URL=https://api.duotopia.com
