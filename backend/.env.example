DATABASE_URL=postgresql://duotopia_user:duotopia_pass@localhost:5432/duotopia

# ===== AUDIO ERROR MONITORING =====
# 錄音錯誤監控永遠連接到生產環境 Supabase（BigQuery 錯誤日誌是全局的）
PROD_DATABASE_POOLER_URL=postgresql://postgres.YOUR_PROD_PROJECT:YOUR_PROD_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ===== SUPABASE REALTIME (Live Quiz 收卷推播 #835) =====
# 老師收卷時，後端 POST 一則 Realtime Broadcast 到 live-quiz:{assignment_id} 頻道。
# 缺 URL/KEY → 靜默略過 broadcast，學生端 polling fallback 接手（收卷流程不受影響）。
# 金鑰優先序：SUPABASE_SERVICE_KEY > SUPABASE_KEY > SUPABASE_ANON_KEY。
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
# ===== GOOGLE OAUTH 老師登入 (#740) =====
# GOOGLE_REDIRECT_URI 必須與 Google Console 註冊的完全一致：
#   develop / staging / per-issue → staging 後端 relay 端點（下方預設值）
#   production                    → https://duotopia.co/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://duotopia-staging-backend-b2ovkkgl6a-de.a.run.app/api/auth/google/relay

# ===== 1CAMPUS SSO =====
ONE_CAMPUS_OAUTH_CLIENT_ID=your-1campus-oauth-client-id
ONE_CAMPUS_OAUTH_CLIENT_SECRET=your-1campus-oauth-client-secret
ONE_CAMPUS_OAUTH_REDIRECT_URI=http://localhost:5173/auth/1campus/callback
ONE_CAMPUS_CLIENT_ID=your-1campus-api-client-id
ONE_CAMPUS_CLIENT_SECRET=your-1campus-api-client-secret

OPENAI_API_KEY=your-openai-api-key-here
GCP_PROJECT_ID=duotopia-472708

# ===== BILLING MONITORING CONFIGURATION =====
# 每日帳單報告管理員設定
ADMIN_EMAIL=myduotopia@gmail.com                # 接收帳單報告的管理員 Email
ADMIN_NAME=Duotopia Admin                       # 管理員姓名（用於郵件稱呼）

# 異常檢測設定
ANOMALY_THRESHOLD=50                            # 異常閾值百分比（默認 50%）
SAVE_HISTORY=true                               # 是否保存歷史數據（默認 true）

# Email 服務設定（用於發送帳單報告）
SMTP_HOST=smtp.gmail.com                        # SMTP 伺服器
SMTP_PORT=587                                   # SMTP 埠口
SMTP_USER=your-smtp-username                    # SMTP 用戶名
SMTP_PASSWORD=your-smtp-app-password            # SMTP 密碼（Gmail 使用 App Password）
FROM_EMAIL=noreply@duotopia.com                 # 發件人 Email
FROM_NAME=Duotopia Billing System               # 發件人名稱
FRONTEND_URL=http://localhost:5173              # Frontend URL（用於郵件中的連結）

# ===== TAPPAY CONFIGURATION =====
# 切換環境：sandbox 或 production
TAPPAY_ENV=sandbox

# ----- Sandbox 參數 (測試環境) -----
TAPPAY_SANDBOX_APP_ID=164155
TAPPAY_SANDBOX_APP_KEY=your-sandbox-app-key-here
TAPPAY_SANDBOX_PARTNER_KEY=your-sandbox-partner-key-here
TAPPAY_SANDBOX_MERCHANT_ID=your-sandbox-merchant-id-here

# ----- Production 參數 (正式環境) -----
# 待取得正式帳號後填入
TAPPAY_PRODUCTION_APP_ID=your-production-app-id-here
TAPPAY_PRODUCTION_APP_KEY=your-production-app-key-here
TAPPAY_PRODUCTION_PARTNER_KEY=your-production-partner-key-here
TAPPAY_PRODUCTION_MERCHANT_ID=your-production-merchant-id-here

# ===== LINE 官方帳號 / 官網更新公告（issue #804） =====
# 與 CI 通知共用同一個 LINE channel（Secret Manager: line-channel-access-token）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# 非 production 環境「發布 LINE」時只推播給這個使用者，不會 broadcast 給真實好友
LINE_TEST_USER_ID=your-line-user-id
# 公告樣板圖（先用官網現有圖片佔位）
RELEASE_ANNOUNCEMENT_BANNER_URL=https://duotopia.co/android-chrome-512x512.png
# CI 呼叫「產生公告草稿」webhook 用的密鑰（未設定則該端點關閉）
RELEASE_WEBHOOK_SECRET=generate-a-random-secret
