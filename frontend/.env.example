# Environment
VITE_ENVIRONMENT=development

# API Endpoint
# Default: Local backend
# For VM backend: Use 'npm run dev:vm' (loads .env.local.vm)
VITE_API_URL=http://localhost:8080

# ===== ANALYTICS / ADS TRACKING =====
# GA4 Measurement ID（全站 page view 追蹤）
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Meta (Facebook) Pixel ID（廣告轉換追蹤）
VITE_META_PIXEL_ID=YOUR_META_PIXEL_ID_HERE

# ===== TAPPAY CONFIGURATION =====
# 切換環境：sandbox 或 production
VITE_TAPPAY_SERVER_TYPE=sandbox

# ----- Sandbox 參數 (測試環境) -----
VITE_TAPPAY_SANDBOX_APP_ID=164155
VITE_TAPPAY_SANDBOX_APP_KEY=YOUR_SANDBOX_APP_KEY_HERE

# ----- Production 參數 (正式環境) -----
# 待取得 TapPay 正式帳號後填入
VITE_TAPPAY_PRODUCTION_APP_ID=YOUR_PRODUCTION_APP_ID_HERE
VITE_TAPPAY_PRODUCTION_APP_KEY=YOUR_PRODUCTION_APP_KEY_HERE
